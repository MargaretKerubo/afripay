# Server configuration
PORT=8080

# SQLite configuration
DATABASE_URL=afripay.db

# JWT Secret configuration
JWT_SECRET=your_jwt_signing_secret_here_make_it_long_and_secure

# Lightning Network LND REST Node Configuration (from Polar)
# Example: https://127.0.0.1:8081 for Alice REST
LND_HOST=
# Hexadecimal encoded LND admin macaroon
LND_MACAROON=
# Absolute path to tls.cert file (if required by your client configuration)
LND_TLS_CERT_PATH=
